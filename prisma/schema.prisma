generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBERSHIP_COORDINATOR
  BOARD_MEMBER
  COMMITTEE_ARCH
  COMMITTEE_SOCIAL
  COMMITTEE_LANDSCAPE
  MEMBER
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Committee {
  ARCHITECTURE
  SOCIAL
  LANDSCAPE
}

enum CommitteeRole {
  CHAIR
  MEMBER
}

enum DocCategory {
  HOA_GENERAL
  BOARD
  COMMITTEE_ARCH
  COMMITTEE_SOCIAL
  COMMITTEE_LANDSCAPE
}

enum ContactRecipient {
  BOARD
  ARCHITECTURE
  SOCIAL
  LANDSCAPE
}

enum ArcRequestType {
  ADDITION
  PORCH
  SHED
  DECK_PATIO
  ROOFING
  GAZEBO_PLAYHOUSE
  EXTERIOR_PAINT
  FENCE
  WALL_LANDSCAPING
  MAILBOX
  OTHER
}

enum ArcStatus {
  PROCESSING
  COMPLETED
}

enum ArcDecision {
  APPROVED
  CONDITIONAL_APPROVAL
  DENIED
}

enum ArcAttachmentLabel {
  SURVEY
  PHOTOS
  PLANS
  LANDSCAPING
  COMMITTEE_RESPONSE
  OTHER
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  passwordHash   String
  status         MemberStatus @default(PENDING)
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  roles               UserRole[]
  profile             MemberProfile?
  boardPosition       BoardPosition?
  committeeMemberships CommitteeMembership[]
  documents           Document[]
  events              CalendarEvent[]
  posts               CommunityPost[]
  comments            CommunityComment[]
  surveyResponses     SurveyResponse[]
  surveysCreated      Survey[]
  spouseOfProfiles    MemberProfile[] @relation("SpouseLink")
  arcRequests         ArcRequest[]    @relation("ArcRequester")
  arcDecisions        ArcRequest[]    @relation("ArcDecidedBy")
  arcAttachments      ArcAttachment[] @relation("ArcAttachmentUploader")
  pageViews           PageView[]
}

/** A single role grant. A user can hold several at once (e.g. Board Member + Membership Coordinator). */
model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role

  @@unique([userId, role])
}

model MemberProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address        String?
  phone          String?
  publicEmail    String?
  children       String?
  pets           String?
  interests      String?
  workInfo       String?
  showInDirectory Boolean @default(true)
  photoUrl       String?
  spouseName     String?
  spouseId       String?
  spouse         User?    @relation("SpouseLink", fields: [spouseId], references: [id], onDelete: SetNull)
  updatedAt      DateTime @updatedAt
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  category  DocCategory @default(HOA_GENERAL)
  sortOrder Int      @default(0)
  documents Document[]
  createdAt DateTime @default(now())
  /// When set, this folder is a pointer to a dedicated feature page (e.g. ARC Requests) rather than real storage.
  linkUrl   String?
}

model Document {
  id           String      @id @default(cuid())
  title        String
  fileUrl      String
  fileType     String?
  category     DocCategory @default(HOA_GENERAL)
  folderId     String?
  folder       Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime    @default(now())
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean  @default(false)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  attachments EventAttachment[]
}

model EventAttachment {
  id        String        @id @default(cuid())
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String
  createdAt DateTime      @default(now())
}

model CommitteeMembership {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  committee Committee
  role      CommitteeRole @default(MEMBER)
  approved  Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@unique([userId, committee])
}

model BoardPosition {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String
  sortOrder Int      @default(0)
}

model Sponsor {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  linkUrl   String?
  blurb     String?
  sortOrder Int      @default(0)
}

model FaqItem {
  id        String @id @default(cuid())
  question  String
  answer    String
  sortOrder Int    @default(0)
}

model PageContent {
  key           String   @id
  title         String?
  body          String?
  imageUrl      String?
  secondaryUrl  String?
  updatedAt     DateTime @updatedAt
}

model CommunityCategory {
  id        String          @id @default(cuid())
  name      String
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  posts     CommunityPost[]
}

model CommunityPost {
  id         String             @id @default(cuid())
  authorId   String
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  subject    String             @default("")
  categoryId String?
  category   CommunityCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  body       String
  imageUrl   String?
  createdAt  DateTime           @default(now())
  comments   CommunityComment[]
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  fileUrl   String?
  fileName  String?
  createdAt DateTime      @default(now())
}

enum SurveyVote {
  STRONGLY_AGREE
  AGREE
  DISAGREE
  STRONGLY_DISAGREE
  UNSURE
}

model Survey {
  id             String           @id @default(cuid())
  title          String
  description    String?
  attachmentUrl  String?
  attachmentName String?
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  responses      SurveyResponse[]
}

model SurveyResponse {
  id        String     @id @default(cuid())
  surveyId  String
  survey    Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vote      SurveyVote
  points    Int
  comment   String?
  createdAt DateTime   @default(now())

  @@unique([surveyId, userId])
}

model ContactMessage {
  id        String           @id @default(cuid())
  recipient ContactRecipient
  fromName  String
  fromEmail String
  message   String
  createdAt DateTime         @default(now())
}

model ArcRequest {
  id             String   @id @default(cuid())
  requesterId    String
  requester      User     @relation("ArcRequester", fields: [requesterId], references: [id])
  sequenceNumber Int      @default(1)

  // I. Request Submitter Information (snapshot at submission time)
  requesterName    String
  requesterAddress String
  requesterPhone   String?
  requesterEmail   String

  // II. Requested Change
  requestType      ArcRequestType
  requestTypeOther String?

  // III. Specific Description of Improvement, Modification or Change
  locationOnProperty String?
  sizeDimensions     String?
  color              String?
  materials          String?
  startDate          DateTime?
  completionDate     DateTime?
  contractorName     String?
  contractorAddress  String?
  contractorPhone    String?

  // Workflow / Architectural Control Committee use only
  status                ArcStatus    @default(PROCESSING)
  decision              ArcDecision?
  decisionReason        String?
  dateReviewed          DateTime?
  dateHomeownerNotified DateTime?
  decidedAt             DateTime?
  decidedById           String?
  decidedBy             User?        @relation("ArcDecidedBy", fields: [decidedById], references: [id])

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  attachments ArcAttachment[]

  @@unique([requesterId, sequenceNumber])
}

model ArcAttachment {
  id           String             @id @default(cuid())
  arcRequestId String
  arcRequest   ArcRequest         @relation(fields: [arcRequestId], references: [id], onDelete: Cascade)
  label        ArcAttachmentLabel
  fileUrl      String
  fileName     String
  uploadedById String
  uploadedBy   User               @relation("ArcAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime           @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
